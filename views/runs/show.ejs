<%
  function formatWarsaw(val) {
    if (!val) return '';
    let s = String(val).trim();
    if (!s.endsWith('Z') && !s.includes('+')) s = s.replace(' ', 'T') + 'Z';
    const dt = new Date(s);
    return dt.toLocaleString('en-GB', { timeZone: 'Europe/Warsaw' });
  }
  const records = (typeof rows !== 'undefined' && rows) ? rows : ((typeof results !== 'undefined' && results) ? results : []);
%>

<div class="card-panel">
  <!-- Run Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
    <div>
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
        <span class="badge-id">Run #<%= run.id.slice(0, 8) %></span>
        <span class="badge-success">Completed</span>
      </div>
      <h2 style="margin: 0 0 6px 0;">Prediction Results: <%= dataset.filename %></h2>
      <p style="margin: 0; color: #666; font-size: 14px;">
        Executed: <b><%= formatWarsaw(run.created_at) %> (Warsaw)</b> &middot; Model: <code><%= run.model_version %></code> &middot; Schema: <code><%= run.schema_version %></code>
      </p>
    </div>
    <a href="/datasets/<%= dataset.id %>" class="button-small" style="text-decoration: none;">&larr; Back to Dataset</a>
  </div>

  <!-- Key Run Metrics Grid -->
  <div class="metric-grid grid-4">
    <div class="stat-tile">
      <span class="stat-label">Total Evaluated</span>
      <strong><%= run.total_records %></strong>
    </div>

    <div class="stat-tile">
      <span class="stat-label">At-Risk Students</span>
      <strong style="color: var(--color-danger, #d32f2f);"><%= run.at_risk_count %></strong>
    </div>

    <div class="stat-tile">
      <span class="stat-label">Clear / Not At Risk</span>
      <strong style="color: var(--primary, #19724f);"><%= run.total_records - run.at_risk_count %></strong>
    </div>

    <div class="stat-tile">
      <span class="stat-label">Decision Threshold</span>
      <strong><%= Number(run.threshold).toFixed(2) %></strong>
    </div>
  </div>

  <!-- Educational Prototype Disclaimer Banner -->
  <div style="background: rgba(25, 114, 79, 0.05); border-left: 4px solid var(--primary, #19724f); padding: 14px 18px; border-radius: 6px; margin: 24px 0;">
    <strong style="color: var(--primary, #19724f); font-size: 15px;">Educational Prototype Disclaimer</strong>
    <p style="margin: 6px 0 0; color: #444; font-size: 13.5px; line-height: 1.5;">
      Risk scores reflect estimated retrospective probabilities of scoring below 10/20 on final assessment (G3) under the frozen model.
      Scores are statistical indicators for educational discussion and do NOT constitute a definitive personal evaluation, clinical diagnosis, or final grade guarantee.
    </p>
  </div>

  <!-- Student Predictions Table -->
  <h3>Student Risk Evaluations (Page <%= pagination.page %> of <%= pagination.totalPages %>)</h3>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Row ID</th>
          <th>G1 Grade</th>
          <th>Risk Probability</th>
          <th>Classification</th>
        </tr>
      </thead>
      <tbody>
        <% if (records && records.length > 0) { %>
          <% records.forEach(r => { %>
            <tr>
              <td><code><%= r.row_identifier %></code></td>
              <td><%= (typeof r.g1 !== 'undefined' && r.g1 !== null) ? r.g1 + '/20' : 'N/A' %></td>
              <td><b><%= Number(r.risk_score).toFixed(2) %></b></td>
              <td>
                <% if (r.risk_flag === 1 || r.risk_score >= run.threshold) { %>
                  <span class="badge-danger">At-Risk</span>
                <% } else { %>
                  <span class="badge-success">Clear</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align: center; color: #777; padding: 24px;">No student records found in this run.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include("../partials/pagination", { pagination }) %>

  <!-- AI & ST Deliverables: Candidate Comparison Section -->
  <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border, #e2e8e0);">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
      <h3 style="margin: 0;">Model Candidate Validation Comparison (AI &amp; ST Benchmark)</h3>
      <span class="badge-range">Precommitted Rule Selection</span>
    </div>
    <p style="margin: 0 0 16px 0; color: #666; font-size: 13.5px;">
      Independent validation results on the Mathematics cohort (N=59, Threshold = 0.50). Decision signed by ST and frozen by AI in Sprint 3.
    </p>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Candidate Model</th>
            <th>Accuracy</th>
            <th>Precision</th>
            <th>Recall</th>
            <th>F1 Score</th>
            <th>Confusion Counts</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Baseline (Dummy Majority)</td>
            <td>67.8%</td>
            <td>0.0%</td>
            <td>0.0%</td>
            <td>0.0000</td>
            <td><small>TP:0 FP:0 FN:19 TN:40</small></td>
            <td><span class="badge-range">Baseline</span></td>
          </tr>
          <tr>
            <td>Logistic Regression (Balanced)</td>
            <td>81.4%</td>
            <td>66.7%</td>
            <td>84.2%</td>
            <td>0.7442</td>
            <td><small>TP:16 FP:8 FN:3 TN:32</small></td>
            <td><span class="badge-range">Candidate</span></td>
          </tr>
          <tr style="background: rgba(25, 114, 79, 0.06); font-weight: 600;">
            <td>Random Forest (100 Trees, Depth 5)</td>
            <td>89.8%</td>
            <td>81.0%</td>
            <td>89.5%</td>
            <td>0.8500</td>
            <td><small>TP:17 FP:4 FN:2 TN:36</small></td>
            <td><span class="badge-success">Winning Frozen Model</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Model Provenance & Settings -->
    <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
      <div style="padding: 12px 14px; background: #fafcfa; border: 1px solid var(--border, #e2e8e0); border-radius: 6px;">
        <span class="stat-label">Model Provenance</span>
        <div style="font-size: 13px; color: #444; line-height: 1.5; margin-top: 4px;">
          <strong>Artifact:</strong> <code>student_risk_v1.pkl</code><br>
          <strong>Trained on:</strong> 276 train rows (no validation/test refit)<br>
          <strong>Dependencies:</strong> scikit-learn 1.3.2, Python 3.12.10
        </div>
      </div>
      <div style="padding: 12px 14px; background: #fafcfa; border: 1px solid var(--border, #e2e8e0); border-radius: 6px;">
        <span class="stat-label">Hyperparameters</span>
        <div style="font-size: 13px; color: #444; line-height: 1.5; margin-top: 4px;">
          <code>n_estimators: 100</code>, <code>max_depth: 5</code><br>
          <code>min_samples_leaf: 5</code>, <code>class_weight: balanced</code><br>
          <code>random_state: 42</code>, <code>features: 31 canonical</code>
        </div>
      </div>
    </div>

    <!-- Held-out Test Split Quarantine Notice -->
    <div style="margin-top: 16px; padding: 12px 16px; background: #fafbfc; border: 1px dashed var(--border, #e2e8e0); border-radius: 6px;">
      <span class="stat-label" style="margin-bottom: 2px;">Held-Out Test Set Quarantine Notice</span>
      <p style="margin: 0; color: #666; font-size: 13px; line-height: 1.4;">
        The test split (N=60, <code>data/test.csv</code>) remains strictly quarantined and un-evaluated to preserve model evaluation integrity. Final held-out test metrics will be published in Sprint 4.
      </p>
    </div>
  </div>
</div>
