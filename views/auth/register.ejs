<div class="card-panel" style="max-width: 420px; margin: 40px auto;">
  <h2>Create Account</h2>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group" style="margin-bottom:16px;">
      <label for="username">Username</label>
      <input class="form-input" id="username" name="username" pattern="[a-z0-9_-]{3,40}" required>

      <label for="email">Email Address</label>
      <input class="form-input" type="email" id="email" name="email" required>
    </div>

    <div class="form-group" style="margin-bottom:16px;">
      <label for="password">Password (min 8 characters)</label>
      <input class="form-input" type="password" id="password" name="password" minlength="8" required>
    </div>

    <div class="form-group" style="margin-bottom:20px;">
      <label for="confirmPassword">Confirm Password</label>
      <input class="form-input" type="password" id="confirmPassword" name="confirmPassword" minlength="8" required>
    </div>

    <button type="submit" class="button" style="width:100%;">Register</button>
  </form>

  <p style="margin-top:16px; font-size:14px;">Already have an account? <a href="/login">Sign In</a></p>
</div>