<div class="auth-wrapper">
  <div class="card-panel auth-card">
    <div class="auth-header">
      <span class="auth-badge">Welcome Back</span>
      <h2>Sign In</h2>
      <p class="panel-subtitle">Access your uploaded datasets and machine learning risk evaluations.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert error" role="alert"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Email Address or Username</label>
        <input class="form-input" type="text" id="email" name="email" placeholder="name@school.edu or username" required autofocus>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="button" style="width:100%; margin-top:8px;">Sign In</button>
    </form>

    <div class="auth-footer">
      <p>Don't have an account? <a href="/register" class="link-primary">Register</a></p>
    </div>
  </div>
</div>
