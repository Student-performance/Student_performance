<div class="card-panel" style="max-width: 420px; margin: 40px auto;">
  <h2>Sign In</h2>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <form action="/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group" style="margin-bottom:16px;">
      <label for="email">Email Address or Username</label>
      <input class="form-input" type="text" id="email" name="email" required>
    </div>

    <div class="form-group" style="margin-bottom:20px;">
      <label for="password">Password</label>
      <input class="form-input" type="password" id="password" name="password" required>
    </div>

    <button type="submit" class="button" style="width:100%;">Sign In</button>
  </form>

  <p style="margin-top:16px; font-size:14px;">Don't have an account? <a href="/register">Register</a></p>
</div>