<%
  function formatWarsaw(val) {
    if (!val) return { date: '', time: '' };
    let s = String(val).trim();
    if (!s.endsWith('Z') && !s.includes('+')) {
      s = s.replace(' ', 'T') + 'Z';
    }
    const dt = new Date(s);
    return {
      date: dt.toLocaleDateString('en-CA', { timeZone: 'Europe/Warsaw' }),
      time: dt.toLocaleTimeString('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' })
    };
  }
%>
<div class="dashboard-grid">
  <!-- Main Column: Datasets -->
  <div class="dashboard-main">
    <div class="card-panel">
      <div class="panel-header">
        <div>
          <h2>My Uploaded Datasets</h2>
          <p class="panel-subtitle">Manage validated student cohorts and inspect baseline statistics.</p>
        </div>
        <a href="/datasets/upload" class="button">Upload New CSV</a>
      </div>

      <% if (datasets.length === 0) { %>
        <div class="empty-state">
          <span class="empty-icon">📊</span>
          <p class="empty-title">No datasets uploaded yet</p>
          <p class="empty-sub">Upload your first <code>student-mat.csv</code> to view G1 distributions and run risk predictions.</p>
          <a href="/datasets/upload" class="button-small" style="margin-top: 12px;">Upload CSV</a>
        </div>
      <% } else { %>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Dataset</th>
                <th>Rows</th>
                <th>G1 Mean</th>
                <th>G1 Range</th>
                <th>Uploaded</th>
                <th style="text-align: right; width: 1%; white-space: nowrap;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% datasets.forEach(d => { %>
                <tr>
                  <td>
                    <div class="dataset-name-cell">
                      <b><%= d.filename %></b>
                      <span class="badge-id" title="Dataset ID">#<%= d.id.slice(0, 8) %></span>
                    </div>
                  </td>
                  <td><%= d.row_count %></td>
                  <td><b><%= d.g1_mean.toFixed(2) %>/20</b></td>
                  <td><span class="badge-range"><%= d.g1_min %> &mdash; <%= d.g1_max %></span></td>
                  <td>
                    <% const warsawUpload = formatWarsaw(d.created_at); %>
                    <div class="upload-time-cell">
                      <span class="upload-date"><%= warsawUpload.date %></span>
                      <span class="upload-time"><%= warsawUpload.time %></span>
                    </div>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a href="/datasets/<%= d.id %>" class="button-small">View Details</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <%- include("../partials/pagination", { pagination }) %>
      <% } %>
    </div>
  </div>

  <!-- Sidebar Column: Persistent Recent Prediction Runs -->
  <div class="dashboard-sidebar">
    <div class="card-panel sidebar-card">
      <div class="panel-header-compact">
        <h3>Recent Prediction Runs</h3>
        <span class="badge-count"><%= (typeof recentRuns !== 'undefined' && recentRuns) ? recentRuns.length : 0 %></span>
      </div>

      <% if (!recentRuns || recentRuns.length === 0) { %>
        <div class="empty-runs">
          <span class="runs-icon">🎯</span>
          <p class="runs-empty-title">No predictions yet</p>
          <p class="runs-empty-sub">Sprint 3 connects the frozen ML model. Once active, select any dataset on the left to trigger inference.</p>
        </div>
      <% } else { %>
        <ul class="runs-list">
          <% recentRuns.forEach(run => { %>
            <li class="run-item">
              <div class="run-info">
                <a href="/runs/<%= run.id %>" class="run-title">Run #<%= run.id.slice(0, 8) %></a>
                <span class="run-dataset"><%= run.filename %></span>
                <% const warsawRun = formatWarsaw(run.created_at); %>
                <span class="run-date">
                  <%= warsawRun.date %> <%= warsawRun.time %>
                </span>
              </div>
              <div class="run-badge-wrap">
                <% if (typeof run.at_risk_count !== 'undefined') { %>
                  <span class="badge-risk <%= (run.at_risk_count > 0) ? 'high' : 'low' %>"><%= run.at_risk_count %> / <%= run.total_records %> At-Risk</span>
                <% } else { %>
                  <span class="badge-completed">Completed</span>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>
