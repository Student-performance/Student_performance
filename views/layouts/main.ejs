<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Student Performance' : 'Student Performance' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="site-body">
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-icon">SP</span>
        <span class="brand-text"><b>student</b>performance</span>
      </a>
      <nav class="nav-links">
        <% if (locals.user) { %>
          <a href="/datasets" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Dataset')) ? 'active' : '' %>">Dashboard</a>
          <a href="/datasets/upload" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Upload')) ? 'active' : '' %>">Upload CSV</a>
          <a href="/evaluation" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Evaluation')) ? 'active' : '' %>">Evaluation</a>
          <a href="/help" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Help')) ? 'active' : '' %>">Help</a>
          <form action="/logout" method="POST" style="display:inline; margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-logout">
              <span class="user-pill"><%= user.username %></span> Sign out
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Sign In')) ? 'active' : '' %>">Sign In</a>
          <a href="/register" class="nav-item <%= (typeof title !== 'undefined' && title.includes('Create Account')) ? 'active' : '' %>">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <div class="flash-messages" aria-live="polite">
    <div id="success-message" class="flash-success" role="status"></div>
    <div id="error-message" class="flash-error" role="alert"></div>
  </div>

  <main class="page-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <strong>Student Performance</strong> &mdash; Educational Course Demonstration
      </div>
      <div class="footer-meta">
        <span>Machine Learning &amp; Web Integration MVP</span>
        <span class="footer-dot">&bull;</span>
        <span>Sprint 3</span>
      </div>
    </div>
  </footer>
</body>
</html>
